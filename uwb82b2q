-- Slider with optional typed input
local OriginalSlider = Library.Slider

Library.Slider = function(Self, Params)
    local Slider = OriginalSlider(Self, Params)

    if Params and (Params.Input or Params.input) and not Params.Parent then
        Library:AttachNumberInput(Slider)
    end

    return Slider
end

-- Button, each added button becomes its own searchable entry and gets a ripple
local OriginalButton = Library.Button

Library.Button = function(Self)
    local Button = OriginalButton(Self)
    local OriginalAdd = Button.Add

    Button.Add = function(ButtonSelf, Name, Callback)
        local Result, NewButton = OriginalAdd(ButtonSelf, Name, Callback)

        local Holder = Button.Items.Button.Instance
        local Children = Holder:GetChildren()
        local Instance

        for Index = #Children, 1, -1 do
            if Children[Index]:IsA("TextButton") then
                Instance = Children[Index]
                break
            end
        end

        if Instance then
            Instance.ClipsDescendants = true
            Library:AttachRipple(Instance)

            local Entry = Library:RegisterElement({
                Name = tostring(Name),
                Items = { }
            }, "Button", Self, Holder, { Instance })

            if Entry then
                Entry.Name = tostring(Name)
                Entry.Default = nil
            end
        end

        return Result, NewButton
    end

    Button.SetVisibility = function(_, Bool)
        Button.Items.Button.Instance.Visible = Bool
    end

    return Button
end
