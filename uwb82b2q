        Name = "\0",
        Parent = Buttons.Instance,
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalFlex = Enum.UIFlexAlignment.Fill,
        VerticalFlex = Enum.UIFlexAlignment.Fill,
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder
    })

    local Levels = {
        Info = Library.Theme["Text"],
        Success = Library.NotificationTypes.Success.Color,
        Warning = Library.NotificationTypes.Warning.Color,
        Warn = Library.NotificationTypes.Warning.Color,
        Error = Library.NotificationTypes.Error.Color
    }

    function Console:Log(Text, Level)
        Level = Level or "Info"

        local Line = string.format("[%s] %s", os.date("%H:%M:%S"), tostring(Text))
        table.insert(Console.Lines, Line)

        local Row = Library:Create("TextLabel", {
            Name = "\0",
            Parent = Scroll.Instance,
            FontFace = Library.Font,
            TextSize = Library.FontSize,
            Text = Line,
            TextColor3 = Levels[Level] or Library.Theme["Text"],
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -6, 0, 15),
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            LayoutOrder = #Console.Lines,
            ZIndex = PanelZ + 3
        })

        table.insert(Console.Rows, Row)

        while #Console.Rows > Console.MaxLines do
            local Old = table.remove(Console.Rows, 1)
            table.remove(Console.Lines, 1)

            if Old.Instance then
                Old.Instance:Destroy()
            end
        end

        task.defer(function()
            if Scroll.Instance then
                Scroll.Instance.CanvasPosition = Vector2.new(0, Scroll.Instance.AbsoluteCanvasSize.Y)
            end
        end)
    end

    function Console:Info(Text)
        Console:Log(Text, "Info")
    end

    function Console:Success(Text)
        Console:Log(Text, "Success")
    end

    function Console:Warn(Text)
        Console:Log(Text, "Warning")
    end

    function Console:Error(Text)
        Console:Log(Text, "Error")
    end

    function Console:Clear()
        for _, Row in Console.Rows do
            if Row.Instance then
                Row.Instance:Destroy()
            end
        end

        Console.Rows = { }
        Console.Lines = { }
    end

    function Console:Export()
        return table.concat(Console.Lines, "\n")
    end

    function Console:HookOutput(Bool)
        if Bool == Console.Hooked then
            return
        end

        Console.Hooked = Bool

        if Bool and not Console.HookConnection then
            Console.HookConnection = Library:Connect(LogService.MessageOut, function(Message, Type)
                if not Console.Hooked then
                    return
                end

                local Level = "Info"

                if Type == Enum.MessageType.MessageWarning then
                    Level = "Warning"
                elseif Type == Enum.MessageType.MessageError then
                    Level = "Error"
                end

                Console:Log(Message, Level)
            end)
        end
    end

    PanelButton(Buttons.Instance, "Clear", function()
        Console:Clear()
    end).Instance.LayoutOrder = 1

    PanelButton(Buttons.Instance, "Copy", function()
        if CopyText(Console:Export()) then
            Library:Success("Console copied", 2)
        else
            Library:Error("Clipboard not supported", 2)
        end
    end).Instance.LayoutOrder = 2

    if Params.HookOutput then
        Console:HookOutput(true)
    end

    Library.LogPanel = Console
    Console:Log("Console ready", "Success")

    return Console
end

-- Hotkey overview
function Library:HotkeyPanel(Params)
    Params = Params or { }

    local Panel = Library:Panel({
        Name = Params.Title or "Hotkeys",
        Size = Vector2.new(260, 280),
        Position = Params.Position or Vector2.new(340, 480),
        OnClose = Params.OnClose
    })

    local Content = Panel.Items["Content"].Instance
    local Scroll = PanelScroll(Content, UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 1, 0))

    local Hotkeys = {
        Panel = Panel,
        Rows = { }
    }

    local Build = function()
        for _, Row in Hotkeys.Rows do
            Row.Frame.Instance:Destroy()
        end

        Hotkeys.Rows = { }

        for Index, Data in Library.Keybinds do
            local Frame = Library:Create("Frame", {
                Name = "\0",
                Parent = Scroll.Instance,
                Size = UDim2.new(1, -4, 0, 20),
                BorderSizePixel = 0,
                LayoutOrder = Index,
                ZIndex = PanelZ + 3,
                BackgroundColor3 = Library.Theme["Inline"]
            }):AddToTheme({BackgroundColor3 = "Inline"})

            local Dot = Library:Create("Frame", {
                Name = "\0",
                Parent = Frame.Instance,
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 6, 0.5, 0),
                Size = UDim2.new(0, 6, 0, 6),
                BorderSizePixel = 0,
                ZIndex = PanelZ + 4,
                BackgroundColor3 = Library.Theme["Element"]
            })

            local Name = Library:Create("TextLabel", {
                Name = "\0",
                Parent = Frame.Instance,
                FontFace = Library.Font,
                TextSize = Library.FontSize,
                Text = Data.Name,
                TextColor3 = Library.Theme["Text"],
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 18, 0, 0),
                Size = UDim2.new(0.5, -18, 1, 0),
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = PanelZ + 4
            }):AddToTheme({TextColor3 = "Text"})

            local Key = Library:Create("TextLabel", {
                Name = "\0",
                Parent = Frame.Instance,
                FontFace = Library.Font,
                TextSize = Library.FontSize,
                Text = "",
                TextColor3 = Library.Theme["Inactive Text"],
                BackgroundTransparency = 1,
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -6, 0, 0),
                Size = UDim2.new(0.5, -6, 1, 0),
                TextXAlignment = Enum.TextXAlignment.Right,
                ZIndex = PanelZ + 4
            }):AddToTheme({TextColor3 = "Inactive Text"})

            table.insert(Hotkeys.Rows, {
                Frame = Frame,
                Dot = Dot,
                Name = Name,
                Key = Key,
                Data = Data
            })
        end
    end

    function Hotkeys:Update()
        if #Hotkeys.Rows ~= #Library.Keybinds then
            Build()
        end

        for _, Row in Hotkeys.Rows do
            local Keybind = Row.Data.Object
            local Value = tostring(Keybind.Value or "")

            if Value == "" then
                Value = "None"
            end

            Row.Key.Instance.Text = string.format("%s [%s]", tostring(Keybind.Mode or ""), Value)

            if Keybind.Toggled then
                Row.Dot.Instance.BackgroundColor3 = Library.Theme["Accent"]
            else
                Row.Dot.Instance.BackgroundColor3 = Library.Theme["Element"]
            end
        end
    end

    local Elapsed = 0

    Library:Connect(RunService.Heartbeat, function(Delta)
        Elapsed += Delta

        if Elapsed >= 0.25 then
            Elapsed = 0

            if Panel.IsOpen then
                Hotkeys:Update()
            end
        end
    end)

    Hotkeys:Update()

    Library.HotkeyPanelObject = Hotkeys
    return Hotkeys
end

