local OriginalToggle = Library.Toggle

Library.Toggle = function(Self, Params)
    local Toggle = OriginalToggle(Self, Params)

    local Indicator = Toggle.Items["Indicator"]

    if not Indicator then
        return Toggle
    end

    local Short = Library:Create("Frame", {
        Name = "\0",
        Parent = Indicator.Instance,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 4, 0, 7),
        Size = UDim2.new(0, 2, 0, 0),
        Rotation = -45,
        BorderSizePixel = 0,
        ZIndex = 2,
        BackgroundColor3 = Library.Theme.Background
    }):AddToTheme({BackgroundColor3 = "Background"})

    local Long = Library:Create("Frame", {
        Name = "\0",
        Parent = Indicator.Instance,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 7, 0, 5),
        Size = UDim2.new(0, 2, 0, 0),
        Rotation = 45,
        BorderSizePixel = 0,
        ZIndex = 2,
        BackgroundColor3 = Library.Theme.Background
    }):AddToTheme({BackgroundColor3 = "Background"})

    local Back = TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    local Out = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

    local Animate = function(Bool, Instant)
        local ShortSize = UDim2.new(0, 2, 0, Bool and 5 or 0)
        local LongSize = UDim2.new(0, 2, 0, Bool and 8 or 0)

        if Instant then
            Short.Instance.Size = ShortSize
            Long.Instance.Size = LongSize
            return
        end

        Short:Tween({Size = ShortSize}, Bool and Back or Out)
        Long:Tween({Size = LongSize}, Bool and Back or Out)
    end

    local OriginalSet = Toggle.Set

    Toggle.Set = function(ToggleSelf, Bool)
        OriginalSet(ToggleSelf, Bool)
        Animate(Bool and true or false, false)
    end

    Animate(Toggle.Value and true or false, true)

    return Toggle
end
