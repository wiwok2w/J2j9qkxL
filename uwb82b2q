--#region Config helpers (clipboard import/export, ignored flags, reset all)
Library.IgnoredFlags = {
    ImportData = true
}

local OriginalGetConfig = Library.GetConfig

Library.GetConfig = function(Self)
    local Json = OriginalGetConfig(Self)

    if not Json then
        return Json
    end

    local Success, Data = pcall(HttpService.JSONDecode, HttpService, Json)

    if not Success or type(Data) ~= "table" then
        return Json
    end

    for Flag in Library.IgnoredFlags do
        Data[Flag] = nil
    end

    for _, Entry in Library.Registry do
        if Entry.Flag and (Entry.Kind == "Progress" or Entry.Kind == "Status") then
            Data[Entry.Flag] = nil
        end
    end

    return HttpService:JSONEncode(Data)
end

function Library:ExportConfig()
    local Config = Library:GetConfig()

    if not Config then
        Library:Error("Failed to build config", 3)
        return false
    end

    if CopyText(Config) then
        Library:Success("Config copied to clipboard", 3)
        return true
    end

    Library:Error("Clipboard not supported by your executor", 3)
    return false
end

function Library:ImportConfig(Text)
    Text = tostring(Text or "")

    if Text == "" and getclipboard then
        pcall(function()
            Text = getclipboard()
        end)
    end

    if Text == "" then
        Library:Error("Nothing to import, paste your config first", 3)
        return false
    end

    local Valid = pcall(HttpService.JSONDecode, HttpService, Text)

    if not Valid then
        Library:Error("That is not valid config data", 3)
        return false
    end

    local Success, Result = Library:LoadConfig(Text)

    if Success then
        Library:Success("Config imported", 3)
    else
        Library:Error("Import failed: " .. tostring(Result), 4)
    end

    return Success
end

function Library:ResetAll()
    local Count = 0

    for _, Entry in Library.Registry do
        local Skip = not Entry.Flag
            or Entry.Default == nil
            or not SetFlags[Entry.Flag]
            or Entry.TopPage == Library.SettingsPage
            or Entry.Kind == "Progress"
            or Entry.Kind == "Status"
            or Entry.Kind == "Label"
            or Entry.Kind == "Button"
            or (Entry.Kind == "Dropdown" and Entry.Default == "")

        if not Skip then
            local Success = pcall(SetFlags[Entry.Flag], Entry.Default)

            if Success then
                Count += 1
            end
        end
    end

    Library:Info("Reset " .. Count .. " settings", 3)
    return Count
end
--#endregion

