        SortOrder = Enum.SortOrder.LayoutOrder
    })

    Window.Items["SearchBackground"] = Background
    Window.Items["SearchBox"] = Box
    Window.Items["SearchResults"] = Results

    local Highlight = function(Entry)
        if not Entry.Root or not Entry.Root.Parent then
            return
        end

        local Flash = Library:Create("Frame", {
            Name = "\0",
            Parent = Entry.Root,
            Size = UDim2.new(1, 8, 1, 4),
            Position = UDim2.new(0, -4, 0, -2),
            BorderSizePixel = 0,
            ZIndex = 4,
            BackgroundTransparency = 0.6,
            BackgroundColor3 = Library.Theme["Accent"]
        })

        Flash:Tween({BackgroundTransparency = 1}, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))

        task.delay(1.3, function()
            if Flash.Instance then
                Flash.Instance:Destroy()
            end
        end)
    end

    local Navigate = function(Entry)
        if Window.Minimized then
            Window:SetMinimized(false)
        end

        if Entry.TopPage and Entry.TopPage.Turn then
            Entry.TopPage:Turn()
        end

        if Entry.SubPage and Entry.SubPage.Turn then
            Entry.SubPage:Turn()
        end

        task.delay(0.4, function()
            Highlight(Entry)
        end)
    end

    local Clear = function()
        for _, Child in Results.Instance:GetChildren() do
            if Child:IsA("TextButton") then
                Child:Destroy()
            end
        end
    end

    local Refresh = function()
        Clear()

        local Query = Box.Instance.Text:lower()

        if Query == "" then
            Results.Instance.Visible = false
            return
        end

        local Matches = { }

        for _, Entry in Library.Registry do
            if Entry.Kind ~= "Paragraph" and Entry.TopPage and Entry.Root and Entry.Root.Parent then
                local Name = Entry.Name:lower()
                local Position = Name:find(Query, 1, true)

                if Position then
                    table.insert(Matches, { Entry = Entry, Score = Position })
                end
            end
        end

        table.sort(Matches, function(A, B)
            if A.Score ~= B.Score then
                return A.Score < B.Score
            end

            return A.Entry.Name < B.Entry.Name
        end)

        for Index = 1, math.min(#Matches, 8) do
            local Entry = Matches[Index].Entry

            local Row = Library:Create("TextButton", {
                Name = "\0",
                Parent = Results.Instance,
                Size = UDim2.new(1, 0, 0, 20),
                Text = "",
                AutoButtonColor = false,
                BorderSizePixel = 0,
                LayoutOrder = Index,
                ZIndex = 601,
                BackgroundTransparency = 1,
                BackgroundColor3 = Library.Theme["Element"]
            })

            Library:Create("TextLabel", {
                Name = "\0",
                Parent = Row.Instance,
                FontFace = Library.Font,
                TextSize = Library.FontSize,
                Text = Entry.Name,
                TextColor3 = Library.Theme["Text"],
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 6, 0, 0),
                Size = UDim2.new(0.5, -6, 1, 0),
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 602
            }):AddToTheme({TextColor3 = "Text"})

            local Path = (Entry.TopPage and Entry.TopPage.Name or "") .. " > " .. (Entry.SubPage and Entry.SubPage.Name or "")

            Library:Create("TextLabel", {
                Name = "\0",
                Parent = Row.Instance,
                FontFace = Library.Font,
                TextSize = Library.FontSize,
                Text = Path,
                TextColor3 = Library.Theme["Inactive Text"],
                BackgroundTransparency = 1,
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -6, 0, 0),
                Size = UDim2.new(0.5, -6, 1, 0),
                TextXAlignment = Enum.TextXAlignment.Right,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 602
            }):AddToTheme({TextColor3 = "Inactive Text"})

            Row:OnHover(function()
                Row:Tween({BackgroundTransparency = 0}, Quick)
            end, function()
                Row:Tween({BackgroundTransparency = 1}, Quick)
            end)

            Row:Connect("MouseButton1Down", function()
                Results.Instance.Visible = false
                Box.Instance.Text = ""
                Navigate(Entry)
            end)
        end

        if #Matches == 0 then
            local Empty = Library:Create("TextButton", {
                Name = "\0",
                Parent = Results.Instance,
                Size = UDim2.new(1, 0, 0, 20),
                Text = "",
                AutoButtonColor = false,
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                ZIndex = 601
            })

            Library:Create("TextLabel", {
                Name = "\0",
                Parent = Empty.Instance,
                FontFace = Library.Font,
                TextSize = Library.FontSize,
                Text = "No results",
                TextColor3 = Library.Theme["Inactive Text"],
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 6, 0, 0),
                Size = UDim2.new(1, -6, 1, 0),
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 602
            }):AddToTheme({TextColor3 = "Inactive Text"})
        end

        local Absolute = Background.Instance.AbsolutePosition
        Results.Instance.Position = UDim2.fromOffset(Absolute.X, Absolute.Y + Background.Instance.AbsoluteSize.Y + GetInset() + 4)
        Results.Instance.Visible = true
    end

    Library:Connect(Box.Instance:GetPropertyChangedSignal("Text"), Refresh)

    Library:Connect(Box.Instance.FocusLost, function()
        task.delay(0.2, function()
            if Results.Instance then
                Results.Instance.Visible = false
            end
        end)
    end)

    Library:Connect(Box.Instance.Focused, function()
        Refresh()
    end)

    Library:Connect(UserInputService.InputBegan, function(Input, Processed)
        if Processed or not Library.SearchEnabled or not Window.IsOpen then
            return
        end

        if Input.KeyCode == Enum.KeyCode.F and (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then
            task.defer(function()
                Box.Instance:CaptureFocus()
            end)
        end
    end)

    function Window:SetSearchVisible(Bool)
        Library.SearchEnabled = Bool
        Background.Instance.Visible = Bool

        if not Bool then
            Results.Instance.Visible = false
        end
    end
end

