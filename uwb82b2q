--#region Core patches
-- Original Round floors and breaks when Decimals is 0 (1 / 0 = inf -> NaN). This rounds to the nearest step.
Library.Round = function(Self, Number, Float)
    Float = (type(Float) == "number" and Float > 0) and Float or 1
    local Value = math.floor(Number / Float + 0.5) * Float
    return tonumber(string.format("%.10g", Value)) or Value
end

-- Make KeybindList idempotent so calling it twice does not make two lists
local OriginalKeybindList = Library.KeybindList

Library.KeybindList = function(Self, Params)
    if Library.KeyList and Library.KeyList.Items then
        local Name = Params and (Params.Name or Params.name)

        if Name then
            Library.KeyList:SetText(Name)
        end

        return Library.KeyList
    end

    return OriginalKeybindList(Self, Params)
end

-- Make sure a keybind list exists before keybinds are made, and track every keybind for the hotkey panel
local OriginalCreateKeybind = Library.CreateKeybind

Library.CreateKeybind = function(Self, Data)
    if not Library.KeyList then
        OriginalKeybindList(Library, { Name = "Keybinds" })
    end

    local Keybind, Items = OriginalCreateKeybind(Self, Data)

    table.insert(Library.Keybinds, {
        Name = tostring(Data.Name or Data.Flag or "Keybind"),
        Flag = Data.Flag,
        Object = Keybind
    })

    return Keybind, Items
end
--#endregion

--#region Registry, visibility gates, lock state
function Library:ResolveEntry(Entry)
    if not Entry.Root or not Entry.Root.Parent then
        return
    end

    local Visible = true

    for _, Value in Entry.Gates do
        if not Value then
            Visible = false
            break
        end
    end

    Entry.Root.Visible = Visible
end

function Library:SetEntryLocked(Entry, Bool)
    Bool = Bool and true or false
    Entry.Locked = Bool

    if not Entry.Overlay then
        if not Bool then
            return
        end

        Entry.Overlay = Create("TextButton", {
            Name = "\0",
            Parent = Entry.Root,
            Size = UDim2.new(1, 0, 1, 0),
            Text = "",
            AutoButtonColor = false,
            Active = true,
            ZIndex = 3,
            BorderSizePixel = 0,
            BackgroundTransparency = 0.45,
            BackgroundColor3 = Library.Theme.Background
        }):AddToTheme({BackgroundColor3 = "Background"})
    end

    Entry.Overlay.Instance.Visible = Bool
end

function Library:RegisterElement(Object, Kind, Section, Root, Targets)
    if not Root then
        return
    end

    local Entry = {
        Kind = Kind,
        Name = tostring(Object.Name or Kind),
        Object = Object,
        Flag = Object.Flag,
        Default = Object.Default,
        Root = Root,
        Section = Section,
        SubPage = Section and Section.Page,
        TopPage = Section and Section.Page and Section.Page.Page,
        Gates = { User = true, Dependency = true },
        Locked = false,
        Targets = Targets or { Root }
    }

    Object.Entry = Entry

    Object.SetVisibility = function(_, Bool)
        Entry.Gates.User = Bool and true or false
        Library:ResolveEntry(Entry)
    end

    Object.SetLocked = function(Self, Bool)
        Library:SetEntryLocked(Entry, Bool)
        return Self
    end

    Object.IsLocked = function()
        return Entry.Locked
    end

    Object.DependsOn = function(Self, Source, Condition)
        Library:AddDependency(Entry, Source, Condition)
        return Self
    end

    table.insert(Library.Registry, Entry)

    for _, Target in Entry.Targets do
        Library:Connect(Target.InputBegan, function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton2 and not Entry.Locked then
                Library:ShowContextMenu(Entry)
            end
        end)
    end

    return Entry
end

local WrapElement = function(Name, Kind, GetRoot, GetTargets)
    local Original = Library[Name]

    Library[Name] = function(Self, Params, ...)
        local Object = Original(Self, Params, ...)

        if type(Object) == "table" and Object.Items and not (Params and Params.Parent) then
            local Root = GetRoot(Object)

            if Root then
                Library:RegisterElement(Object, Kind, Self, Root, GetTargets and GetTargets(Object))
            end
        end

        return Object
    end
end

WrapElement("Toggle", "Toggle", function(Object)
    return Object.Items.Toggle.Instance
end)

WrapElement("Label", "Label", function(Object)
    return Object.Items.Label.Instance
