        Alpha = math.clamp(Alpha or 0, 0, 1)
        Splash.Progress = Alpha

        Items["Fill"]:Tween({Size = UDim2.new(Alpha, 0, 1, 0)}, Quick)
        Items["Percent"].Instance.Text = string.format("%d%%", math.floor(Alpha * 100 + 0.5))

        if Text then
            Items["Status"].Instance.Text = tostring(Text)
        end
    end

    function Splash:SetStatus(Text)
        Items["Status"].Instance.Text = tostring(Text)
    end

    function Splash:Finish(Callback)
        Splash:SetProgress(1)

        task.delay(0.3, function()
            if not Items["Splash"].Instance then
                return
            end

            Items["Splash"]:FadeDescendants(false, function()
                if Items["Splash"].Instance then
                    Items["Splash"].Instance:Destroy()
                end

                if Callback then
                    Library:SafeCall(Callback)
                end
            end)
        end)
    end

    Items["Splash"]:FadeDescendants(true)

    local Steps = Params.Steps

    if type(Steps) == "table" and #Steps > 0 then
        local Duration = Params.Duration or 2

        Library:Thread(function()
            for Index, Step in Steps do
                Splash:SetProgress((Index - 1) / #Steps, Step)
                task.wait(Duration / #Steps)
            end

            Splash:Finish(Params.OnDone)
        end)
    end

    return Splash
end
