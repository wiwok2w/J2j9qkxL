--#region Tooltip (edge clamped)
Library.Tooltip = function(Self, Text)
    local Object = Self.Instance

    if not Object or Text == nil or Text == "" then
        return
    end

    local Tip = Create("Frame", {
        Name = "\0",
        Parent = Library.Holder.Instance,
        Size = UDim2.new(0, 0, 0, 22),
        AutomaticSize = Enum.AutomaticSize.X,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 800,
        BackgroundColor3 = Library.Theme.Inline
    }):AddToTheme({BackgroundColor3 = "Inline"})

    Create("UIStroke", {
        Name = "\0",
        Parent = Tip.Instance,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        LineJoinMode = Enum.LineJoinMode.Miter,
        Color = Library.Theme.Outline
    }):AddToTheme({Color = "Outline"})

    Create("UIStroke", {
        Name = "\0",
        Parent = Tip.Instance,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        LineJoinMode = Enum.LineJoinMode.Miter,
        Color = Library.Theme["Outline 2"],
        BorderOffset = UDim.new(0, 1)
    }):AddToTheme({Color = "Outline 2"})

    Create("UIPadding", {
        Name = "\0",
        Parent = Tip.Instance,
        PaddingLeft = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 6)
    })

    Create("TextLabel", {
        Name = "\0",
        Parent = Tip.Instance,
        FontFace = Library.Font,
        TextSize = Library.FontSize,
        Text = tostring(Text),
        TextColor3 = Library.Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        ZIndex = 801
    }):AddToTheme({TextColor3 = "Text"})

    Create("Frame", {
        Name = "\0",
        Parent = Tip.Instance,
        Position = UDim2.new(0, -6, 0, 0),
        Size = UDim2.new(0, 1, 1, 0),
        BorderSizePixel = 0,
        ZIndex = 801,
        BackgroundColor3 = Library.Theme.Accent
    }):AddToTheme({BackgroundColor3 = "Accent"})

    local Follow

    local Stop = function()
        Tip.Instance.Visible = false

        if Follow then
            Follow:Disconnect()
            Follow = nil
        end
    end

    local Place = function()
        local Mouse = UserInputService:GetMouseLocation()
        local Screen = Library.Holder.Instance.AbsoluteSize
        local Size = Tip.Instance.AbsoluteSize

        local X = Mouse.X + 16
        local Y = Mouse.Y + 16

        if X + Size.X > Screen.X - 4 then
            X = math.max(4, Mouse.X - Size.X - 12)
        end

        if Y + Size.Y > Screen.Y - 4 then
            Y = math.max(4, Mouse.Y - Size.Y - 12)
        end

        Tip.Instance.Position = UDim2.fromOffset(X, Y)
    end

    Self:OnHover(function()
        Tip.Instance.Visible = true
        Place()

        if Follow then
            Follow:Disconnect()
        end

        Follow = RunService.RenderStepped:Connect(function()
            if not Object.Parent then
                Stop()
                return
            end

            Place()
        end)
    end, Stop)
end
--#endregion

--#region Ripple
function Library:AttachRipple(Instance)
    Library:Connect(Instance.InputBegan, function(Input)
        if Input.UserInputType ~= Enum.UserInputType.MouseButton1 and Input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local Position = Vector2.new(Input.Position.X, Input.Position.Y) - Instance.AbsolutePosition
        local Radius = math.max(Instance.AbsoluteSize.X, Instance.AbsoluteSize.Y) * 1.4

        local Ripple = Create("Frame", {
            Name = "\0",
            Parent = Instance,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset(Position.X, Position.Y),
            Size = UDim2.fromOffset(0, 0),
            BorderSizePixel = 0,
            ZIndex = 5,
            BackgroundTransparency = 0.75,
            BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        })

        Create("UICorner", {
            Name = "\0",
            Parent = Ripple.Instance,
            CornerRadius = UDim.new(1, 0)
        })

        Ripple:Tween({Size = UDim2.fromOffset(Radius, Radius), BackgroundTransparency = 1}, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))

        task.delay(0.55, function()
            if Ripple.Instance then
                Ripple.Instance:Destroy()
            end
        end)
    end)
end
--#endregion

--#region Notifications (types, stack limit, click to dismiss)
Library.NotificationTypes = {
    Success = { Color = Color3.fromRGB(80, 220, 120), Tag = "[+]" },
    Error = { Color = Color3.fromRGB(255, 85, 85), Tag = "[x]" },
    Warning = { Color = Color3.fromRGB(255, 190, 60), Tag = "[!]" },
    Info = { Color = Color3.fromRGB(110, 170, 255), Tag = "[i]" }
}

local NotifyAnim = TweenInfo.new(0.45, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)
local NotifyFade = TweenInfo.new(0.35, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)

local FadeNotificationItems = function(Items, Target)
    for _, Value in Items do
        if not Value.Instance or not Value.Instance.Parent then
            continue
        end

        if Value.Instance:IsA("Frame") then
            Value:Tween({BackgroundTransparency = Target}, NotifyFade)
        elseif Value.Instance:IsA("TextLabel") then
            Value:Tween({TextTransparency = Target}, NotifyFade)
        elseif Value.Instance:IsA("UIStroke") then
            Value:Tween({Transparency = Target}, NotifyFade)
        end
    end
end

Library.Notification = function(Self, Name, Duration, Color, Type)
    Name = tostring(Name or "Notification")
    Duration = Duration or 3

    local TypeData = Type and Library.NotificationTypes[Type]

    if TypeData then
        Color = Color or TypeData.Color
        Name = TypeData.Tag .. " " .. Name
    end

    Color = Color or Library.Theme.Accent

    -- enforce the stack limit by dismissing the oldest ones
    local Alive = 0

    for _, Item in Library.Notifications do
        if not Item.Removing then
            Alive += 1
        end
    end

    if Alive >= Library.MaxNotifications then
        for Index = #Library.Notifications, 1, -1 do
            local Oldest = Library.Notifications[Index]

            if not Oldest.Removing and Oldest.Remove then
                Oldest.Remove()
                Alive -= 1

                if Alive < Library.MaxNotifications then
                    break
                end
            end
        end
    end

    local Slide = Library.NotificationSlide

    local Notification = {
        Removing = false,
        Height = 30,
        Width = 0,
        TargetPosition = UDim2.new(1, -Library.NotificationOrigin.X, 1, -Library.NotificationOrigin.Y),
        Items = { }
    }

    local Items = { } do
        Items["Notification"] = Library:Create("Frame", {
            Name = "\0",
            Parent = Library.NotifHolder.Instance,
            AnchorPoint = Vector2.new(1, 1),
            Position = UDim2.new(1, -Library.NotificationOrigin.X + Slide, 1, -Library.NotificationOrigin.Y),
            BorderSizePixel = 0,
            ClipsDescendants = true,
            AutomaticSize = Enum.AutomaticSize.XY,
            BackgroundColor3 = Library.Theme["Inline"],
            ZIndex = 100
        }):AddToTheme({BackgroundColor3 = "Inline"})

        Items["Stroke2"] = Library:Create("UIStroke", {
            Name = "\0",
            Parent = Items["Notification"].Instance,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            LineJoinMode = Enum.LineJoinMode.Miter,
            Color = Library.Theme["Outline"]
        }):AddToTheme({Color = "Outline"})

        Items["Stroke"] = Library:Create("UIStroke", {
            Name = "\0",
            Parent = Items["Notification"].Instance,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            LineJoinMode = Enum.LineJoinMode.Miter,
            Color = Library.Theme["Outline 2"],
            BorderOffset = UDim.new(0, 1)
        }):AddToTheme({Color = "Outline 2"})

        Library:Create("UIPadding", {
            Name = "\0",
            Parent = Items["Notification"].Instance,
            PaddingTop = UDim.new(0, 6),
            PaddingBottom = UDim.new(0, 6),
            PaddingRight = UDim.new(0, 6),
            PaddingLeft = UDim.new(0, 6)
        })

        Items["Text"] = Library:Create("TextLabel", {
            Name = "\0",
            FontFace = Library.Font,
            TextSize = Library.FontSize,
            Parent = Items["Notification"].Instance,
            TextColor3 = Library.Theme["Text"],
            Text = Name,
            Size = UDim2.new(0, 0, 0, 15),
            BackgroundTransparency = 1,
            TextXAlignment = Enum.TextXAlignment.Right,
            BorderSizePixel = 0,
            AutomaticSize = Enum.AutomaticSize.X,
            ZIndex = 101
        }):AddToTheme({TextColor3 = "Text"})

        Items["Liner"] = Library:Create("Frame", {
            Name = "\0",
            Parent = Items["Notification"].Instance,
            Position = UDim2.new(1, -1, 0, 25),
            AnchorPoint = Vector2.new(1, 0),
            Size = UDim2.new(1, -2, 0, 3),
            BorderSizePixel = 0,
            BackgroundColor3 = Color,
            ZIndex = 101
        })
    end

    Notification.Items = Items

    for _, Value in Items do
        if Value.Instance:IsA("Frame") then
            Value.Instance.BackgroundTransparency = 1
        elseif Value.Instance:IsA("TextLabel") then
            Value.Instance.TextTransparency = 1
        elseif Value.Instance:IsA("UIStroke") then
            Value.Instance.Transparency = 1
        end
    end

    table.insert(Library.Notifications, 1, Notification)

    Notification.Remove = function()
        if Notification.Removing then
            return
        end

        Notification.Removing = true
        Library.RefreshNotifications()

        FadeNotificationItems(Items, 1)

        local Frame = Items["Notification"].Instance

        if Frame and Frame.Parent then
            local Current = Frame.Position
            local Full = Notification.FullSize or Frame.AbsoluteSize

            Items["Notification"]:Tween({
                Position = UDim2.new(1, Current.X.Offset + Slide, 1, Current.Y.Offset),
                Size = UDim2.new(0, Full.X, 0, 0)
            }, NotifyAnim)
        end

        task.delay(NotifyAnim.Time, function()
            local Index = table.find(Library.Notifications, Notification)

            if Index then
                table.remove(Library.Notifications, Index)
            end

            if Items["Notification"].Instance then
                Items["Notification"].Instance:Destroy()
            end

            Library.RefreshNotifications()
        end)
    end

    Library:Thread(function()
        task.wait()

        local Frame = Items["Notification"].Instance

        if not Frame or not Frame.Parent then
            return
        end

        local FullSize = Frame.AbsoluteSize

        if FullSize.X <= 0 or FullSize.Y <= 0 then
            FullSize = Vector2.new(math.max(FullSize.X, 120), math.max(FullSize.Y, 30))
        end

        Notification.Height = FullSize.Y
        Notification.Width = FullSize.X
        Notification.FullSize = FullSize

        Library.RefreshNotifications(Notification)

        local Target = Notification.TargetPosition

        Frame.AutomaticSize = Enum.AutomaticSize.None
        Frame.Size = UDim2.new(0, FullSize.X, 0, FullSize.Y)
        Frame.Position = UDim2.new(1, Target.X.Offset + Slide, 1, Target.Y.Offset)

        local Click = Library:Create("TextButton", {
            Name = "\0",
            Parent = Frame,
            Size = UDim2.new(1, 0, 1, 0),
            Text = "",
            AutoButtonColor = false,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = 110
        })

        Click:Connect("MouseButton1Click", Notification.Remove)

        FadeNotificationItems(Items, 0)
        Items["Notification"]:Tween({Position = Target}, NotifyAnim)
        Items["Liner"].Instance.Size = UDim2.new(1, -2, 0, 3)
        Items["Liner"]:Tween({Size = UDim2.new(0, 0, 0, 3)}, TweenInfo.new(Duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out))

        task.delay(Duration + 0.05, Notification.Remove)
    end)

    if Library.LogPanel then
        Library.LogPanel:Log(Name, Type or "Info")
    end

    return Notification
end

