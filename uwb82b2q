-- Player list
function Library:PlayerList(Params)
    Params = Params or { }

    local Panel = Library:Panel({
        Name = Params.Title or "Player List",
        Size = Vector2.new(270, 340),
        Position = Params.Position or Vector2.new(340, 120),
        OnClose = Params.OnClose
    })

    local Content = Panel.Items["Content"].Instance

    local List = {
        Panel = Panel,
        Selected = nil,
        Rows = { },
        Query = "",
        Callback = Params.Callback or function() end,
        Filter = Params.Filter
    }

    local Search = PanelBox(Content, "Search players...", UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0, 20))
    local Scroll = PanelScroll(Content, UDim2.new(0, 0, 0, 26), UDim2.new(1, 0, 1, -26))

    local GetDistance = function(Player)
        local Mine = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local Theirs = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")

        if Mine and Theirs then
            return math.floor((Mine.Position - Theirs.Position).Magnitude)
        end
    end

    local Style = function(Row, Selected)
        Row.Button:Tween({BackgroundTransparency = Selected and 0 or 1}, Quick)
        Row.Liner:Tween({Size = UDim2.new(0, 2, Selected and 1 or 0, 0)}, Quick)
    end

    function List:Select(Player)
        List.Selected = Player

        for Other, Row in List.Rows do
            Style(Row, Other == Player)
        end

        if Player then
            Library:SafeCall(List.Callback, Player)
        end
    end

    function List:GetSelected()
        return List.Selected
    end

    function List:Refresh()
        local Sorted = Players:GetPlayers()

        table.sort(Sorted, function(A, B)
            return A.Name:lower() < B.Name:lower()
        end)

        for Index, Player in Sorted do
            local Row = List.Rows[Player]

            if not Row then
                local Button = Library:Create("TextButton", {
                    Name = "\0",
                    Parent = Scroll.Instance,
                    Size = UDim2.new(1, -4, 0, 22),
                    Text = "",
                    AutoButtonColor = false,
                    BorderSizePixel = 0,
                    ZIndex = PanelZ + 3,
                    BackgroundTransparency = 1,
                    BackgroundColor3 = Library.Theme["Element"]
                }):AddToTheme({BackgroundColor3 = "Element"})

                local Liner = Library:Create("Frame", {
                    Name = "\0",
                    Parent = Button.Instance,
                    Size = UDim2.new(0, 2, 0, 0),
                    AnchorPoint = Vector2.new(0, 0.5),
                    Position = UDim2.new(0, 0, 0.5, 0),
                    BorderSizePixel = 0,
                    ZIndex = PanelZ + 4,
                    BackgroundColor3 = Library.Theme["Accent"]
                }):AddToTheme({BackgroundColor3 = "Accent"})

                local Dot = Library:Create("Frame", {
                    Name = "\0",
                    Parent = Button.Instance,
                    AnchorPoint = Vector2.new(0, 0.5),
                    Position = UDim2.new(0, 8, 0.5, 0),
                    Size = UDim2.new(0, 6, 0, 6),
                    BorderSizePixel = 0,
                    ZIndex = PanelZ + 4,
                    BackgroundColor3 = Player.TeamColor and Player.TeamColor.Color or Color3.fromRGB(150, 150, 150)
                })

                local Name = Library:Create("TextLabel", {
                    Name = "\0",
                    Parent = Button.Instance,
                    FontFace = Library.Font,
                    TextSize = Library.FontSize,
                    Text = Player == LocalPlayer and (Player.DisplayName .. " (you)") or string.format("%s (@%s)", Player.DisplayName, Player.Name),
                    TextColor3 = Library.Theme["Text"],
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 20, 0, 0),
                    Size = UDim2.new(1, -70, 1, 0),
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    ZIndex = PanelZ + 4
                }):AddToTheme({TextColor3 = "Text"})

                local Distance = Library:Create("TextLabel", {
                    Name = "\0",
                    Parent = Button.Instance,
                    FontFace = Library.Font,
                    TextSize = Library.FontSize,
                    Text = "",
                    TextColor3 = Library.Theme["Inactive Text"],
                    BackgroundTransparency = 1,
                    AnchorPoint = Vector2.new(1, 0),
                    Position = UDim2.new(1, -6, 0, 0),
                    Size = UDim2.new(0, 44, 1, 0),
                    TextXAlignment = Enum.TextXAlignment.Right,
                    ZIndex = PanelZ + 4
                }):AddToTheme({TextColor3 = "Inactive Text"})

                Button:Connect("MouseButton1Down", function()
                    List:Select(Player)
                end)

                Row = {
                    Button = Button,
                    Liner = Liner,
                    Dot = Dot,
                    Name = Name,
                    Distance = Distance
                }

                List.Rows[Player] = Row
            end

            local Query = List.Query
            local Visible = Query == "" or Player.Name:lower():find(Query, 1, true) ~= nil or Player.DisplayName:lower():find(Query, 1, true) ~= nil

            if Visible and List.Filter then
                local Success, Result = pcall(List.Filter, Player)
                Visible = Success and Result and true or false
            end

            Row.Button.Instance.LayoutOrder = Index
            Row.Button.Instance.Visible = Visible
        end

        for Player, Row in List.Rows do
            if not Player.Parent then
                Row.Button.Instance:Destroy()
                List.Rows[Player] = nil

                if List.Selected == Player then
                    List.Selected = nil
                end
            end
        end
    end

    function List:UpdateDistances()
        for Player, Row in List.Rows do
            if Row.Button.Instance and Row.Button.Instance.Visible then
                local Distance = GetDistance(Player)
                Row.Distance.Instance.Text = Distance and (Distance .. "m") or "-"
            end
        end
    end

    Library:Connect(Search.Instance:GetPropertyChangedSignal("Text"), function()
        List.Query = Search.Instance.Text:lower()
        List:Refresh()
    end)

    Library:Connect(Players.PlayerAdded, function()
        List:Refresh()
    end)

    Library:Connect(Players.PlayerRemoving, function()
        task.defer(function()
            List:Refresh()
        end)
    end)

    local Elapsed = 0

    Library:Connect(RunService.Heartbeat, function(Delta)
        Elapsed += Delta

        if Elapsed >= 0.5 then
            Elapsed = 0

            if Panel.IsOpen then
                List:UpdateDistances()
            end
        end
    end)

    List:Refresh()
    List:UpdateDistances()

    Library.PlayerListObject = List
    return List
end

