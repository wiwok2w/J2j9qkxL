--#region Dependencies
local EvaluateDependency = function(Dependency)
    local Value = Flags[Dependency.Flag]
    local Condition = Dependency.Condition
    local Result

    if type(Condition) == "function" then
        local Success, Return = pcall(Condition, Value)
        Result = Success and Return and true or false
    elseif Condition ~= nil then
        if type(Value) == "table" and not Value.Key and not Value.Color and not Value.Mode then
            Result = table.find(Value, Condition) ~= nil
        else
            Result = Value == Condition
        end
    else
        if type(Value) == "table" then
            if Value.Toggled ~= nil then
                Result = Value.Toggled and true or false
            else
                Result = #Value > 0
            end
        else
            Result = Value and true or false
        end
    end

    return Result
end

function Library:AddDependency(Entry, Source, Condition)
    local Flag = type(Source) == "table" and Source.Flag or Source

    local Dependency = {
        Entry = Entry,
        Flag = Flag,
        Condition = Condition,
        Last = nil
    }

    table.insert(Library.Dependencies, Dependency)

    local Result = EvaluateDependency(Dependency)
    Dependency.Last = Result
    Entry.Gates.Dependency = Result
    Library:ResolveEntry(Entry)

    if not Library.DependencyConnection then
        local Elapsed = 0

        Library.DependencyConnection = Library:Connect(RunService.Heartbeat, function(Delta)
            Elapsed += Delta

            if Elapsed < 0.1 then
                return
            end

            Elapsed = 0

            for _, Item in Library.Dependencies do
                local State = EvaluateDependency(Item)

                if State ~= Item.Last then
                    Item.Last = State
                    Item.Entry.Gates.Dependency = State
                    Library:ResolveEntry(Item.Entry)
                end
            end
        end)
    end
end
--#endregion

--#region Context menu (right click)
local ContextMenu

local CloseContextMenu = function()
    if ContextMenu then
        ContextMenu.Instance:Destroy()
        ContextMenu = nil
    end
end

function Library:ShowContextMenu(Entry)
    CloseContextMenu()

    local Actions = { }

    if Entry.Flag and SetFlags[Entry.Flag] and Entry.Default ~= nil and Entry.Kind ~= "Label" then
        table.insert(Actions, {"Reset to default", function()
            SetFlags[Entry.Flag](Entry.Default)
        end})
    end

    if Entry.Flag and Flags[Entry.Flag] ~= nil then
        table.insert(Actions, {"Copy value", function()
            if CopyText(Stringify(Flags[Entry.Flag])) then
                Library:Info("Copied value", 2)
            else
                Library:Error("Clipboard not supported", 2)
            end
        end})
    end

    if Entry.Flag then
        table.insert(Actions, {"Copy flag name", function()
            CopyText(tostring(Entry.Flag))
        end})
    end

    if #Actions == 0 then
        return
    end

    local Mouse = UserInputService:GetMouseLocation()
    local Screen = Library.Holder.Instance.AbsoluteSize

    ContextMenu = Create("Frame", {
        Name = "\0",
        Parent = Library.Holder.Instance,
        Size = UDim2.new(0, 140, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BorderSizePixel = 0,
        ZIndex = 700,
        BackgroundColor3 = Library.Theme.Inline
    }):AddToTheme({BackgroundColor3 = "Inline"})

    local Menu = ContextMenu

    Create("UIStroke", {
        Name = "\0",
        Parent = Menu.Instance,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        LineJoinMode = Enum.LineJoinMode.Miter,
        Color = Library.Theme.Outline
    }):AddToTheme({Color = "Outline"})

    Create("UIStroke", {
        Name = "\0",
        Parent = Menu.Instance,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        LineJoinMode = Enum.LineJoinMode.Miter,
        Color = Library.Theme["Outline 2"],
        BorderOffset = UDim.new(0, 1)
    }):AddToTheme({Color = "Outline 2"})

    Create("UIPadding", {
        Name = "\0",
        Parent = Menu.Instance,
        PaddingTop = UDim.new(0, 4),
        PaddingBottom = UDim.new(0, 4),
        PaddingLeft = UDim.new(0, 4),
        PaddingRight = UDim.new(0, 4)
    })

    Create("UIListLayout", {
        Name = "\0",
        Parent = Menu.Instance,
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder
    })

    for _, Action in Actions do
        local Row = Create("TextButton", {
            Name = "\0",
            Parent = Menu.Instance,
            Size = UDim2.new(1, 0, 0, 20),
            Text = "",
            AutoButtonColor = false,
            BorderSizePixel = 0,
            ZIndex = 701,
            BackgroundTransparency = 1,
            BackgroundColor3 = Library.Theme.Element
        })

        Create("TextLabel", {
            Name = "\0",
            Parent = Row.Instance,
            FontFace = Library.Font,
            TextSize = Library.FontSize,
            Text = Action[1],
            TextColor3 = Library.Theme.Text,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -10, 1, 0),
            Position = UDim2.new(0, 6, 0, 0),
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 702
        }):AddToTheme({TextColor3 = "Text"})

        Row:OnHover(function()
            Row:Tween({BackgroundTransparency = 0}, Quick)
        end, function()
            Row:Tween({BackgroundTransparency = 1}, Quick)
        end)

        Row:Connect("MouseButton1Down", function()
            CloseContextMenu()
            Library:SafeCall(Action[2])
        end)
    end

    Menu.Instance.Position = UDim2.fromOffset(
        math.min(Mouse.X, Screen.X - 150),
        math.min(Mouse.Y, Screen.Y - (#Actions * 22 + 12))
    )
end

Library:Connect(UserInputService.InputBegan, function(Input)
    if not ContextMenu then
        return
    end

    if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
        task.defer(function()
            if ContextMenu and not Over(ContextMenu.Instance) then
                CloseContextMenu()
            end
        end)
    end
end)
