function Library:SetPanelVisible(Key, Bool)
    local Object = Library.PanelObjects[Key]
    local Alive = Object and Object.Panel and Object.Panel.Items["Main"].Instance

    if Bool then
        if not Alive then
            local Factory = Library.PanelFactories[Key]

            if not Factory then
                return
            end

            Library.PanelObjects[Key] = Factory(function()
                local Set = SetFlags["Panel" .. Key]

                if Set and Flags["Panel" .. Key] then
                    Set(false)
                end
            end)
        else
            Object.Panel:SetOpen(true)
        end
    elseif Alive then
        Object.Panel:SetOpen(false)
    end
end
