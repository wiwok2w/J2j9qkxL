        Default = Params.Default or Params.default or 0,
        Min = Params.Min or Params.min or 0,
        Max = Params.Max or Params.max or 100,
        Decimals = Params.Decimals or Params.decimals or 0.01,
        Suffix = Params.Suffix or Params.suffix or "",
        Tooltip = Params.Tooltip or Params.tooltip or "",
        Callback = Params.Callback or Params.callback or function() end,
        Percent = ShowPercent,

        Window = Self.Window,
        Page = Self.Page,
        Section = Self,

        Value = 0,
        Items = { }
    }

    local Parent = Params.Parent or Bar.Section.Items["Content"]

    local Items = { } do
        Items["Progress"] = Library:Create("Frame", {
            Name = "\0",
            Parent = Parent.Instance,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 30),
            BorderSizePixel = 0
        })

        Items["Progress"]:Tooltip(Bar.Tooltip)

        Items["Text"] = Library:Create("TextLabel", {
            Name = "\0",
            FontFace = Library.Font,
            TextSize = Library.FontSize,
            Parent = Items["Progress"].Instance,
            TextColor3 = Library.Theme["Text"],
            Text = Bar.Name,
            Size = UDim2.new(0, 0, 0, 15),
            BackgroundTransparency = 1,
            TextXAlignment = Enum.TextXAlignment.Left,
            AutomaticSize = Enum.AutomaticSize.X
        }):AddToTheme({TextColor3 = "Text"})

        Items["ValueText"] = Library:Create("TextLabel", {
            Name = "\0",
            FontFace = Library.Font,
            TextSize = Library.FontSize,
            Parent = Items["Progress"].Instance,
            TextColor3 = Library.Theme["Inactive Text"],
            Text = "0%",
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, 0, 0, 0),
            Size = UDim2.new(0, 0, 0, 15),
            BackgroundTransparency = 1,
            TextXAlignment = Enum.TextXAlignment.Right,
            AutomaticSize = Enum.AutomaticSize.X
        }):AddToTheme({TextColor3 = "Inactive Text"})

        Items["Bar"] = Library:Create("Frame", {
            Name = "\0",
            Parent = Items["Progress"].Instance,
            AnchorPoint = Vector2.new(0, 1),
            Position = UDim2.new(0, 0, 1, 0),
            Size = UDim2.new(1, 0, 0, 8),
            BorderSizePixel = 0,
            BackgroundColor3 = Library.Theme["Element"]
        }):AddToTheme({BackgroundColor3 = "Element"})

        Library:Create("UIStroke", {
            Name = "\0",
            Parent = Items["Bar"].Instance,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            LineJoinMode = Enum.LineJoinMode.Miter,
            Color = Library.Theme["Outline"]
        }):AddToTheme({Color = "Outline"})

        Items["Fill"] = Library:Create("Frame", {
            Name = "\0",
            Parent = Items["Bar"].Instance,
            Size = UDim2.new(0, 0, 1, 0),
            BorderSizePixel = 0,
            BackgroundColor3 = Library.Theme["Accent"]
        }):AddToTheme({BackgroundColor3 = "Accent"})

        Library:Create("UIGradient", {
            Name = "\0",
            Parent = Items["Fill"].Instance,
            Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(145, 145, 145))
            }
        })

        Bar.Items = Items
    end

    function Bar:Set(Value)
        Value = Library:Round(math.clamp(tonumber(Value) or 0, Bar.Min, Bar.Max), Bar.Decimals)
        Bar.Value = Value

        local Alpha = Bar.Max == Bar.Min and 0 or (Value - Bar.Min) / (Bar.Max - Bar.Min)

        Items["Fill"]:Tween({Size = UDim2.new(Alpha, 0, 1, 0)}, TweenInfo.new(Library.Animation.Time, Enum.EasingStyle.Quart, Enum.EasingDirection.Out))

        if Bar.Percent then
            Items["ValueText"].Instance.Text = string.format("%d%%", math.floor(Alpha * 100 + 0.5))
        else
            Items["ValueText"].Instance.Text = tostring(Value) .. Bar.Suffix
        end

        Flags[Bar.Flag] = Value
        Library:SafeCall(Bar.Callback, Value)
    end

    function Bar:Get()
        return Bar.Value
    end

    function Bar:SetText(Text)
        Items["Text"].Instance.Text = tostring(Text)
    end

    function Bar:SetColor(Color)
        if type(Color) == "string" then
            Items["Fill"]:ChangeItemTheme({BackgroundColor3 = Color})
            Items["Fill"]:Tween({BackgroundColor3 = Library.Theme[Color]})
        else
            Items["Fill"]:ChangeItemTheme({ })
            Items["Fill"]:Tween({BackgroundColor3 = Color})
        end
    end

    function Bar:SetVisibility(Bool)
        Items["Progress"].Instance.Visible = Bool
    end

    SetFlags[Bar.Flag] = function(Value)
        Bar:Set(Value)
    end

    Bar:Set(Bar.Default)

    if Params.Color then
        Bar:SetColor(Params.Color)
    end

    if not Params.Parent then
        Library:RegisterElement(Bar, "Progress", Self, Items["Progress"].Instance)
    end

    return setmetatable(Bar, Library)
end
