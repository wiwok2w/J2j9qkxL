--#region Settings page integration
function Library:BuildExtras()
    local General = Library.SettingsGeneral

    if not General then
        return
    end

    local UISection = Library.Sections["ui settings"]

    -- swap the stock Unload button for one with a confirmation prompt
    if UISection then
        for _, Child in UISection.Items["Content"].Instance:GetChildren() do
            for _, Descendant in Child:GetDescendants() do
                if Descendant:IsA("TextLabel") and Descendant.Text == "Unload" then
                    Child:Destroy()
                    break
                end
            end
        end

        UISection:Slider({
            Name = "UI Scale",
            Flag = "UIScale",
            Min = 0.5,
            Max = 1.5,
            Default = Library.UIScaleValue or 1,
            Decimals = 0.05,
            Input = true,
            Tooltip = "Scales the whole window",
            Callback = function(Value)
                Library:SetScale(Value)
            end
        })

        UISection:Slider({
            Name = "Max Notifications",
            Flag = "MaxNotifications",
            Min = 1,
            Max = 10,
            Default = Library.MaxNotifications,
            Decimals = 1,
            Callback = function(Value)
                Library.MaxNotifications = Value
            end
        })

        UISection:Toggle({
            Name = "Show Search Bar",
            Flag = "ShowSearchBar",
            Default = true,
            Tooltip = "Ctrl+F focuses it",
            Callback = function(Value)
                local Window = Library.MainWindow

                if Window and Window.SetSearchVisible then
                    Window:SetSearchVisible(Value)
                end
            end
        })

        UISection:Toggle({
            Name = "Confirm Unload",
            Flag = "ConfirmUnload",
            Default = true,
            Callback = function(Value)
                Library.ConfirmUnload = Value
            end
        })

        UISection:Button():Add("Reset All Settings", function()
            Library:Confirm({
                Title = "Reset all settings",
                Text = "This sets every setting back to its default value.",
                Yes = "Reset",
                No = "Cancel",
                OnYes = function()
                    Library:ResetAll()
                end
            })
        end)

        UISection:Button():Add("Unload", function()
            if not Library.ConfirmUnload then
                Library:Exit()
                return
            end

            Library:Confirm({
                Title = "Unload",
                Text = "Unload the UI? Unsaved settings will be lost.",
                Yes = "Unload",
                No = "Cancel",
                OnYes = function()
                    Library:Exit()
                end
            })
        end)
    end

    -- config sharing
    local ImportText = ""

    local Share = General:Section({ Name = "config sharing", Side = 1, Collapsible = true })

    Share:Button():Add("Export", function()
        Library:ExportConfig()
    end):Add("Import", function()
        Library:ImportConfig(ImportText)
    end)

    Share:Textbox({
        Name = "Import data",
        Flag = "ImportData",
        Placeholder = "Paste config JSON here",
        Tooltip = "Paste, then press Import. Empty uses the clipboard if supported.",
        Callback = function(Value)
            ImportText = Value
        end
    })

    -- panels
    local Panels = General:Section({ Name = "panels", Side = 2, Collapsible = true })

    local PanelToggle = function(Name, Key)
        Panels:Toggle({
            Name = Name,
            Flag = "Panel" .. Key,
            Default = false,
            Callback = function(Value)
                Library:SetPanelVisible(Key, Value)
            end
        })
    end

    PanelToggle("Player List", "PlayerList")
    PanelToggle("Console", "Console")
    PanelToggle("Hotkeys", "Hotkeys")
    PanelToggle("ESP Preview", "ESP")

    Panels:Toggle({
        Name = "Hook Game Output",
        Flag = "ConsoleHook",
        Default = false,
        Tooltip = "Mirrors print/warn/error output into the console panel",
        Callback = function(Value)
            local Object = Library.PanelObjects["Console"]

            if Object and Object.HookOutput then
                Object:HookOutput(Value)
            end
        end
    })

    Panels:Divider("notification test")

    Panels:Button():Add("Success", function()
        Library:Success("Everything worked", 3)
    end):Add("Error", function()
        Library:Error("Something went wrong", 3)
    end)

    Panels:Button():Add("Warning", function()
        Library:Warn("Careful with that", 3)
    end):Add("Info", function()
        Library:Info("Just so you know", 3)
    end)

    -- the original autoload already ran, re-run it so the new flags are restored too
    Library:Thread(function()
        task.wait(0.25)
        Library:LoadAutoload()
    end)
end

