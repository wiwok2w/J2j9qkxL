local Create = function(Class, Properties)
    return Library:Create(Class, Properties)
end

local GetInset = function()
    return GuiService:GetGuiInset().Y
end

local Over = function(Instance)
    if not Instance or not Instance.Parent then
        return false
    end

    return Library.IsMouseOverFrame({ Instance = Instance })
end

local CopyText = function(Text)
    local Copy = setclipboard or toclipboard or (syn and syn.write_clipboard)

    if Copy then
        local Success = pcall(Copy, Text)
        return Success
    end

    return false
end

local Stringify = function(Value)
    if type(Value) == "table" then
        if Value.HexValue then
            return "#" .. tostring(Value.HexValue)
        end

        if Value.Key then
            return tostring(Value.Key)
        end

        local Success, Json = pcall(HttpService.JSONEncode, HttpService, Value)
        return Success and Json or "table"
    end

    return tostring(Value)
end

local AssetId = function(Id)
    if type(Id) == "number" then
        return "rbxassetid://" .. Id
    end

    Id = tostring(Id or "")

    if Id:match("^%d+$") then
        return "rbxassetid://" .. Id
    end

    return Id
end

