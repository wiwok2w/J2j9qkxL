function Library:AddMinimize(Window)
    local Main = Window.Items["MainFrame"]

    local Button = Library:Create("TextButton", {
        Name = "\0",
        Parent = Main.Instance,
        FontFace = Library.BoldFont,
        TextSize = Library.FontSize,
        Text = "-",
        TextColor3 = Library.Theme["Inactive Text"],
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -8, 0, 5),
        Size = UDim2.new(0, 18, 0, 17),
        AutoButtonColor = false,
        BorderSizePixel = 0,
        ZIndex = 5
    }):AddToTheme({TextColor3 = "Inactive Text"})

    Button:OnHover(function()
        Button:Tween({TextColor3 = Library.Theme["Text"]}, Quick)
    end, function()
        Button:Tween({TextColor3 = Library.Theme["Inactive Text"]}, Quick)
    end)

    Window.Minimized = false

    local Busy = false
    local SavedSize

    function Window:SetMinimized(Bool)
        Bool = Bool and true or false

        if Busy or Window.Minimized == Bool then
            return
        end

        Busy = true
        Window.Minimized = Bool
        Window:ClosePopups()

        local Frame = Main.Instance

        for _, Child in Frame:GetChildren() do
            if Child:IsA("TextButton") and Child.ZIndex == 99999 then
                Child.Visible = not Bool
            end
        end

        if Bool then
            SavedSize = Frame.Size
            Window.Items["Content"]:FadeDescendants(false)
            Window.Items["Pages"]:FadeDescendants(false)
            Main:Tween({Size = UDim2.new(SavedSize.X.Scale, SavedSize.X.Offset, 0, 28)}, Slow)
            Button.Instance.Text = "+"
        else
            Main:Tween({Size = SavedSize or UDim2.new(0, 564, 0, 592)}, Slow)

